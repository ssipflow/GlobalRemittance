org.springframework.boot.diagnostics.FailureAnalyzer=\
com.nelson.remittance.bootstrap.diagnostics.DatabaseConnectionFailureAnalyzer,\
com.nelson.remittance.bootstrap.diagnostics.LockTimeoutFailureAnalyzer,\
com.nelson.remittance.bootstrap.diagnostics.SocketTimeoutFailureAnalyzer
org.springframework.boot.env.EnvironmentPostProcessor=\
com.nelson.remittance.bootstrap.diagnostics.LockTimeoutEnvironmentPostProcessor,\
com.nelson.remittance.bootstrap.diagnostics.SocketTimeoutEnvironmentPostProcessor
